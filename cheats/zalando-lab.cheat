% kubernetes, postgres, zalando, credentials

# Decode specific key from a Zalando Postgres Secret
kubectl get secret <secret_name> -n <namespace> -o jsonpath='{.data.<key>}' | base64 --decode; echo

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ secret_name: kubectl get secrets -n <namespace> | awk 'NR>1 {print $1}'
$ key: kubectl get secret <secret_name> -n <namespace> -o go-template='{{range $k, $v := .data}}{{$k}}{{"\n"}}{{end}}'

# Extract and decode Application Owner password
kubectl get secret app-owner.<cluster_name>.credentials.postgresql.acid.zalan.do -n <namespace> -o jsonpath='{.data.password}' | base64 --decode; echo

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Extract and decode Postgres superuser password
kubectl get secret postgres.<cluster_name>.credentials.postgresql.acid.zalan.do -n <namespace> -o jsonpath='{.data.password}' | base64 --decode; echo

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

% kubernetes, postgres, patroni, topology

# Run patronictl list inside Spilo container
kubectl exec -it <spilo_pod> -n <namespace> -c postgres -- patronictl list

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'
$ spilo_pod: kubectl get pods -n <namespace> -l cluster-name=<cluster_name> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Run patronictl topology to inspect replication lag
kubectl exec -it <spilo_pod> -n <namespace> -c postgres -- patronictl topology

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'
$ spilo_pod: kubectl get pods -n <namespace> -l cluster-name=<cluster_name> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Inspect Patroni leader election ConfigMap
kubectl get configmap <cluster_name>-leader -n <namespace> -o yaml

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Watch Spilo pod roles in real time
kubectl get pods -n <namespace> -l cluster-name=<cluster_name> -L spilo-role -w

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

% kubernetes, postgres, failover, ha

# Trigger a planned Patroni switchover
kubectl exec -it <spilo_pod> -n <namespace> -c postgres -- patronictl switchover

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'
$ spilo_pod: kubectl get pods -n <namespace> -l cluster-name=<cluster_name> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Abruptly kill the active primary (master) pod
kubectl delete pod <master_pod> -n <namespace> --now

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'
$ master_pod: kubectl get pods -n <namespace> -l cluster-name=<cluster_name>,spilo-role=master -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Pause Kind worker node running primary (simulate node outage)
docker pause <worker_node>

$ worker_node: docker ps --format '{{.Names}}' | grep worker

# Unpause Kind worker node (restore node health)
docker unpause <worker_node>

$ worker_node: docker ps --filter "status=paused" --format '{{.Names}}'

% kubernetes, postgres, connectivity, port-forward

# Port-forward the Primary (Master) service
kubectl port-forward svc/<cluster_name> 5432:5432 -n <namespace>

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Port-forward the Replica (Read-Only) service
kubectl port-forward svc/<cluster_name>-repl 5433:5432 -n <namespace>

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Port-forward the PgBouncer pooler service (the Service listens on 5432)
kubectl port-forward svc/<cluster_name>-pooler 6432:5432 -n <namespace>

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Open interactive psql shell via in-cluster pgclient pod
kubectl exec -it <client_pod> -n <namespace> -- psql "host=<cluster_name> user=app_owner dbname=appdb sslmode=require"

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'
$ client_pod: kubectl get pods -n <namespace> | grep pgclient | awk '{print $1}'

% kubernetes, postgres, backup, wal-g

# List WAL-G base backups from Spilo container
kubectl exec -it <spilo_pod> -n <namespace> -c postgres -- envdir "/run/etc/wal-e.d/env" wal-g backup-list

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'
$ spilo_pod: kubectl get pods -n <namespace> -l cluster-name=<cluster_name> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

% kubernetes, postgres, logs, troubleshooting

# Stream Zalando Postgres Operator logs
kubectl logs -f deploy/postgres-operator -n <operator_namespace> --since=1m

$ operator_namespace: kubectl get namespaces | awk 'NR>1 {print $1}'

# Stream Spilo container logs (Postgres + Patroni)
kubectl logs -f <spilo_pod> -n <namespace> -c postgres

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'
$ spilo_pod: kubectl get pods -n <namespace> -l cluster-name=<cluster_name> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'

# Stream PgBouncer pooler logs (all pooler pods)
kubectl logs -f deploy/<cluster_name>-pooler -n <namespace> --all-pods --prefix

$ namespace: kubectl get namespaces | awk 'NR>1 {print $1}'
$ cluster_name: kubectl get postgresql -n <namespace> -o jsonpath='{.items[*].metadata.name}' | tr ' ' '\n'
